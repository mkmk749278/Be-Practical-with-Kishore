  "speech_vs_text": 1.83,
  "boundary_margin": 4.926,
  "confidence": "check"
 },
 {
  "line": 110,
  "start": 354.141,
  "end": 358.736,
  "te": "The reactor made no power in nineteen ninety five, ninety six or ninety seven.",
  "en": "",
  "speech_vs_text": 1.0,
  "boundary_margin": 0.129,
  "confidence": "high"
 },
 {
  "line": 111,
  "start": 359.039,
