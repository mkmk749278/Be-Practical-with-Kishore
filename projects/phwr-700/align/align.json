  "speech_vs_text": 1.28,
  "boundary_margin": 1.891,
  "confidence": "high"
 },
 {
  "line": 144,
  "start": 454.133,
  "end": 456.216,
  "te": "Three hundred and six in each reactor.",
  "en": "",
  "speech_vs_text": 1.02,
  "boundary_margin": 9.9,
  "confidence": "high"
 },
 {
  "line": 145,
  "start": 456.551,
  "end": 460.403,
  "te": "A former chief of N-P-C-I-L put it in words you will not forget.",
