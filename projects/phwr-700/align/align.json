  "speech_vs_text": 2.26,
  "boundary_margin": 2.336,
  "confidence": "check"
 },
 {
  "line": 141,
  "start": 444.719,
  "end": 447.799,
  "te": "The regulator found it only in Kakrapar's two units.",
