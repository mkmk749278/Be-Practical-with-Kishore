[
 {
  "line": 1,
  "start": 0.0,
  "end": 6.328,
  "te": "In nineteen seventy four, Canada walked out of a half built nuclear reactor on the Chambal river, in Rajasthan.",
  "en": "",
  "speech_vs_text": 1.01,
  "boundary_margin": 0.281,
  "confidence": "high"
 },
 {
  "line": 2,
  "start": 6.842,
  "end": 7.885,
  "te": "India finished it.",
  "en": "",
  "speech_vs_text": 0.88,
  "boundary_margin": 0.281,
  "confidence": "high"
 },
 {
  "line": 3,
  "start": 8.288,
  "end": 11.246,
  "te": "But twenty years later, its heart was wearing out.",
  "en": "",
  "speech_vs_text": 1.0,
  "boundary_margin": 0.565,
  "confidence": "high"
 },
 {
  "line": 4,
  "start": 11.708,
  "end": 14.082,
  "te": "Three hundred and six thin metal tubes.",
  "en": "",
  "speech_vs_text": 1.05,
  "boundary_margin": 0.538,
  "confidence": "high"
 },
 {
  "line": 5,
  "start": 14.45,
  "end": 17.352,
  "te": "Only one country had ever replaced tubes like these.",
  "en": "",
  "speech_vs_text": 1.03,
  "boundary_margin": 0.538,
  "confidence": "high"
 },
 {
  "line": 6,
  "start": 17.866,
  "end": 18.222,
  "te": "Canada.",
  "en": "",
  "speech_vs_text": 0.9,
  "boundary_margin": 9.9,
  "confidence": "high"
 },
 {
  "line": 7,
  "start": 18.639,
  "end": 21.613,
  "te": "And Canada's export rules kept its companies from helping.",
  "en": "",
  "speech_vs_text": 0.94,
  "boundary_margin": 9.9,
  "confidence": "high"
 },
 {
  "line": 8,
  "start": 22.049,
  "end": 25.995,
  "te": "So how do you rebuild the heart of a machine that nobody will teach you to open?",
  "en": "",
  "speech_vs_text": 0.95,
  "boundary_margin": 0.149,
  "confidence": "high"
 },
 {
  "line": 9,
  "start": 26.456,
  "end": 32.186,
  "te": "By the end, you will see Indian engineers pull those tubes out, one by one, into a steel flask.",
  "en": "",
  "speech_vs_text": 1.03,
  "boundary_margin": 0.149,
  "confidence": "high"
 },
 {
  "line": 10,
  "start": 32.557,
  "end": 38.596,
  "te": "And you will see why it matters for the new reactor that began taking in fuel this September, on the same lake.",
  "en": "",
  "speech_vs_text": 1.0,
  "boundary_margin": 0.197,
  "confidence": "high"
 },
 {
  "line": 11,
  "start": 39.105,
  "end": 40.626,
  "te": "Let me take you to Rawatbhata.",
  "en": "",
  "speech_vs_text": 0.96,
  "boundary_margin": 0.394,
  "confidence": "high"
 },
 {
  "line": 12,
  "start": 41.023,
  "end": 45.527,
  "te": "A small town on the Rana Pratap Sagar lake, about sixty four kilometres from Kota.",
  "en": "",
  "speech_vs_text": 1.0,
  "boundary_margin": 0.615,
  "confidence": "high"
 },
 {
  "line": 13,
  "start": 46.004,
  "end": 52.193,
  "te": "If you had come here in the nineteen sixties, you would have seen Canada and India building a nuclear power station together.",
  "en": "",
  "speech_vs_text": 0.89,
  "boundary_margin": 0.615,
  "confidence": "high"
 },
 {
  "line": 14,
  "start": 52.6,
  "end": 54.188,
  "te": "Its design came from Canada.",
  "en": "",
  "speech_vs_text": 1.05,
  "boundary_margin": 2.873,
  "confidence": "high"
 },
 {
  "line": 15,
  "start": 54.547,
  "end": 55.653,
  "te": "And why that design?",
  "en": "",
  "speech_vs_text": 1.05,
  "boundary_margin": 0.614,
  "confidence": "high"
 },
 {
  "line": 16,
  "start": 55.998,
  "end": 58.188,
  "te": "India had picked it for one simple reason.",
  "en": "",
  "speech_vs_text": 0.9,
  "boundary_margin": 0.614,
  "confidence": "high"
 },
 {
  "line": 17,
  "start": 58.515,
  "end": 60.5,
  "te": "It needs no enriched uranium.",
  "en": "",
  "speech_vs_text": 1.26,
  "boundary_margin": 1.111,
  "confidence": "high"
 },
 {
  "line": 18,
  "start": 60.856,
  "end": 65.243,
  "te": "You can run it on natural uranium, with the same mix of atoms you find in nature.",
  "en": "",
  "speech_vs_text": 1.01,
  "boundary_margin": 0.885,
  "confidence": "high"
 },
 {
  "line": 19,
  "start": 65.568,
  "end": 67.576,
  "te": "And Indian factories could build it.",
  "en": "",
  "speech_vs_text": 0.9,
  "boundary_margin": 0.245,
  "confidence": "high"
 },
 {
  "line": 20,
  "start": 67.961,
  "end": 72.206,
  "te": "Now, you have probably seen a reactor drawn as one giant steel pot.",
  "en": "",
  "speech_vs_text": 1.22,
  "boundary_margin": 0.245,
  "confidence": "high"
 },
 {
  "line": 21,
  "start": 72.585,
  "end": 74.654,
  "te": "Most reactors in the world are just that.",
  "en": "",
  "speech_vs_text": 0.95,
  "boundary_margin": 0.338,
  "confidence": "high"
 },
 {
  "line": 22,
  "start": 75.019,
  "end": 76.349,
  "te": "This one is different.",
  "en": "",
  "speech_vs_text": 0.94,
  "boundary_margin": 0.338,
  "confidence": "high"
 },
 {
  "line": 23,
  "start": 76.761,
  "end": 80.137,
  "te": "Imagine a tank, pierced by three hundred and six tubes.",
  "en": "",
  "speech_vs_text": 1.07,
  "boundary_margin": 0.431,
  "confidence": "high"
 },
 {
  "line": 24,
  "start": 80.494,
  "end": 83.434,
  "te": "Each tube, if you like, is its own small pressure cooker.",
  "en": "",
  "speech_vs_text": 1.02,
  "boundary_margin": 1.317,
  "confidence": "high"
 },
 {
  "line": 25,
  "start": 83.877,
  "end": 85.166,
  "te": "Think of the cooker in your kitchen.",
  "en": "",
  "speech_vs_text": 0.68,
  "boundary_margin": 0.555,
  "confidence": "check"
 },
 {
  "line": 26,
  "start": 85.494,
  "end": 87.726,
  "te": "You know that whistle, you have heard it all your life.",
  "en": "",
  "speech_vs_text": 0.71,
  "boundary_margin": 0.195,
  "confidence": "high"
 },
 {
  "line": 27,
  "start": 88.199,
  "end": 92.56,
  "te": "Inside, the steam pushes at about one kilo on every square centimetre.",
  "en": "",
  "speech_vs_text": 1.11,
  "boundary_margin": 0.195,
  "confidence": "high"
 },
 {
  "line": 28,
  "start": 92.933,
  "end": 95.954,
  "te": "Now jump ahead to India's newest reactors for a moment.",
  "en": "",
  "speech_vs_text": 0.99,
  "boundary_margin": 0.083,
  "confidence": "high"
 },
 {
  "line": 29,
  "start": 96.287,
  "end": 102.217,
  "te": "There, the water in each tube is pushed a hundred times harder, at three hundred and ten degrees.",
  "en": "",
  "speech_vs_text": 1.04,
  "boundary_margin": 0.083,
  "confidence": "high"
 },
 {
  "line": 30,
  "start": 102.563,
  "end": 107.629,
  "te": "And in reactors of this family, the wall of that tube is only about four millimetres thick.",
  "en": "",
  "speech_vs_text": 0.97,
  "boundary_margin": 0.254,
  "confidence": "high"
 },
 {
  "line": 31,
  "start": 108.063,
  "end": 108.86,
  "te": "Think of a pencil.",
  "en": "",
  "speech_vs_text": 0.87,
  "boundary_margin": 1.337,
  "confidence": "high"
 },
 {
  "line": 32,
  "start": 109.151,
  "end": 110.675,
  "te": "The wall is thinner than that.",
  "en": "",
  "speech_vs_text": 0.97,
  "boundary_margin": 9.9,
  "confidence": "high"
 },
 {
  "line": 33,
  "start": 111.07,
  "end": 113.096,
  "te": "Then came May nineteen seventy four.",
  "en": "",
  "speech_vs_text": 1.03,
  "boundary_margin": 9.9,
  "confidence": "high"
 },
 {
  "line": 34,
  "start": 113.44,
  "end": 114.123,
  "te": "You remember it.",
  "en": "",
  "speech_vs_text": 0.8,
  "boundary_margin": 9.9,
  "confidence": "high"
 },
 {
  "line": 35,
  "start": 114.416,
  "end": 114.796,
  "te": "Pokhran.",
  "en": "",
  "speech_vs_text": 0.83,
  "boundary_margin": 9.9,
  "confidence": "high"
 },
 {
  "line": 36,
  "start": 115.217,
  "end": 116.748,
  "te": "Why did Canada care so much?",
  "en": "",
  "speech_vs_text": 1.06,
  "boundary_margin": 1.39,
  "confidence": "high"
 },
 {
  "line": 37,
  "start": 117.085,
  "end": 118.877,
  "te": "India called its test peaceful.",
  "en": "",
  "speech_vs_text": 0.93,
  "boundary_margin": 0.203,
  "confidence": "high"
 },
 {
  "line": 38,
  "start": 119.244,
  "end": 125.102,
  "te": "Canada saw plutonium from a research reactor near Mumbai, called Cyrus, which Canada had helped design.",
  "en": "",
  "speech_vs_text": 0.95,
  "boundary_margin": 0.184,
  "confidence": "high"
 },
 {
  "line": 39,
  "start": 125.471,
  "end": 127.433,
  "te": "So Canada stopped its nuclear help.",
  "en": "",
  "speech_vs_text": 1.03,
  "boundary_margin": 0.184,
  "confidence": "high"
 },
 {
  "line": 40,
  "start": 127.733,
  "end": 129.71,
  "te": "The engineers packed up and went home.",
  "en": "",
  "speech_vs_text": 0.89,
  "boundary_margin": 0.354,
  "confidence": "high"
 },
 {
  "line": 41,
  "start": 130.044,
  "end": 131.473,
  "te": "The first unit was running.",
  "en": "",
  "speech_vs_text": 0.86,
  "boundary_margin": 0.312,
  "confidence": "high"
 },
 {
  "line": 42,
  "start": 131.826,
  "end": 137.259,
  "te": "The second, as an Indian magazine put it in nineteen ninety six, the Canadians abandoned halfway.",
  "en": "",
  "speech_vs_text": 0.94,
  "boundary_margin": 0.312,
  "confidence": "high"
 },
 {
  "line": 43,
  "start": 137.752,
  "end": 141.783,
  "te": "Now you might ask me, Kishore, so what happened to your half built reactor?",
  "en": "",
  "speech_vs_text": 0.93,
  "boundary_margin": 0.394,
  "confidence": "high"
 },
 {
  "line": 44,
  "start": 142.205,
  "end": 144.303,
  "te": "Indian engineers finished it on their own.",
  "en": "",
  "speech_vs_text": 0.91,
  "boundary_margin": 1.603,
  "confidence": "high"
 },
 {
  "line": 45,
  "start": 144.646,
  "end": 146.488,
  "te": "It went to work in nineteen eighty one.",
  "en": "",
  "speech_vs_text": 0.9,
  "boundary_margin": 0.487,
  "confidence": "high"
 },
 {
  "line": 46,
  "start": 146.789,
  "end": 148.48,
  "te": "And for a while, all was well.",
  "en": "",
  "speech_vs_text": 0.94,
  "boundary_margin": 0.309,
  "confidence": "high"
 },
 {
  "line": 47,
  "start": 148.746,
  "end": 156.097,
  "te": "At Kaiga in Karnataka, a reactor of this family once ran for nine hundred and sixty two days without stopping.",
  "en": "",
  "speech_vs_text": 1.13,
  "boundary_margin": 0.309,
  "confidence": "high"
 },
 {
  "line": 48,
  "start": 156.584,
  "end": 157.437,
  "te": "A world record.",
  "en": "",
  "speech_vs_text": 1.08,
  "boundary_margin": 0.343,
  "confidence": "high"
 },
 {
  "line": 49,
  "start": 158.08,
  "end": 160.071,
  "te": "So what stops a machine like that?",
  "en": "",
  "speech_vs_text": 1.03,
  "boundary_margin": 0.343,
  "confidence": "high"
 },
 {
  "line": 50,
  "start": 160.61,
  "end": 162.022,
  "te": "You might guess the fuel.",
  "en": "",
  "speech_vs_text": 0.91,
  "boundary_margin": 0.642,
  "confidence": "high"
 },
 {
  "line": 51,
  "start": 162.631,
  "end": 163.626,
  "te": "It is not the fuel.",
  "en": "",
  "speech_vs_text": 1.08,
  "boundary_margin": 0.642,
  "confidence": "high"
 },
 {
  "line": 52,
  "start": 164.049,
  "end": 166.336,
  "te": "You can feed fresh fuel in while it runs.",
  "en": "",
  "speech_vs_text": 1.09,
  "boundary_margin": 0.434,
  "confidence": "high"
 },
 {
  "line": 53,
  "start": 166.876,
  "end": 168.735,
  "te": "What wears out is the tubes.",
  "en": "",
  "speech_vs_text": 1.09,
  "boundary_margin": 0.434,
  "confidence": "high"
 },
 {
  "line": 54,
  "start": 169.261,
  "end": 171.98,
  "te": "The early tubes were made of an older metal mix.",
  "en": "",
  "speech_vs_text": 1.09,
  "boundary_margin": 0.328,
  "confidence": "high"
 },
 {
  "line": 55,
  "start": 172.384,
  "end": 174.547,
  "te": "Over the years they soaked up hydrogen.",
  "en": "",
  "speech_vs_text": 0.88,
  "boundary_margin": 0.145,
  "confidence": "high"
 },
 {
  "line": 56,
  "start": 175.094,
  "end": 181.826,
  "te": "N-P-C-I-L, the company that runs India's nuclear plants, says they lasted only ten to twelve years.",
  "en": "",
  "speech_vs_text": 1.18,
  "boundary_margin": 0.145,
  "confidence": "high"
 },
 {
  "line": 57,
  "start": 182.277,
  "end": 186.874,
  "te": "In August nineteen eighty three, near Toronto, the world saw what that means.",
  "en": "",
  "speech_vs_text": 1.0,
  "boundary_margin": 0.221,
  "confidence": "high"
 },
 {
  "line": 58,
  "start": 187.399,
  "end": 190.686,
  "te": "At the Pickering station, one tube broke at full power.",
  "en": "",
  "speech_vs_text": 1.04,
  "boundary_margin": 0.308,
  "confidence": "high"
 },
 {
  "line": 59,
  "start": 191.189,
  "end": 193.029,
  "te": "Just one, out of hundreds.",
  "en": "",
  "speech_vs_text": 1.12,
  "boundary_margin": 0.067,
  "confidence": "high"
 },
 {
  "line": 60,
  "start": 193.547,
  "end": 195.184,
  "te": "But that is all it takes.",
  "en": "",
  "speech_vs_text": 0.97,
  "boundary_margin": 0.067,
  "confidence": "high"
 },
 {
  "line": 61,
  "start": 195.781,
  "end": 197.721,
  "te": "How does a tube just break?",
  "en": "",
  "speech_vs_text": 1.27,
  "boundary_margin": 0.273,
  "confidence": "high"
 },
 {
  "line": 62,
  "start": 198.262,
  "end": 200.824,
  "te": "Each hot tube sits inside a cooler tube.",
  "en": "",
  "speech_vs_text": 1.22,
  "boundary_margin": 0.273,
  "confidence": "high"
 },
 {
  "line": 63,
  "start": 201.187,
  "end": 204.663,
  "te": "Small coiled springs, wrapped around it, keep the two apart.",
  "en": "",
  "speech_vs_text": 1.04,
  "boundary_margin": 0.336,
  "confidence": "high"
 },
 {
  "line": 64,
  "start": 205.112,
  "end": 208.189,
  "te": "In that one channel, a spring had slipped out of place.",
  "en": "",
  "speech_vs_text": 0.98,
  "boundary_margin": 0.228,
  "confidence": "high"
 },
 {
  "line": 65,
  "start": 208.641,
  "end": 210.673,
  "te": "Slowly, the hot tube sagged.",
  "en": "",
  "speech_vs_text": 0.96,
  "boundary_margin": 0.143,
  "confidence": "high"
 },
 {
  "line": 66,
  "start": 211.06,
  "end": 212.791,
  "te": "Then it touched the cold one.",
  "en": "",
  "speech_vs_text": 0.81,
  "boundary_margin": 0.143,
  "confidence": "high"
 },
 {
  "line": 67,
  "start": 213.338,
  "end": 215.958,
  "te": "Now think of a glass of cold water on a hot day.",
  "en": "",
  "speech_vs_text": 1.04,
  "boundary_margin": 0.196,
  "confidence": "high"
 },
 {
  "line": 68,
  "start": 216.443,
  "end": 219.485,
  "te": "You have seen the drops gather on the outside, on the cold glass.",
  "en": "",
  "speech_vs_text": 0.85,
  "boundary_margin": 0.196,
  "confidence": "high"
 },
 {
  "line": 69,
  "start": 220.047,
  "end": 223.976,
  "te": "Inside the metal, hydrogen did something like the drops you just pictured.",
  "en": "",
  "speech_vs_text": 0.9,
  "boundary_margin": 0.137,
  "confidence": "high"
 },
 {
  "line": 70,
  "start": 224.382,
  "end": 226.076,
  "te": "It crept to the coldest spot.",
  "en": "",
  "speech_vs_text": 0.86,
  "boundary_margin": 0.129,
  "confidence": "high"
 },
 {
  "line": 71,
  "start": 226.684,
  "end": 229.569,
  "te": "And there it hardened into brittle blisters.",
  "en": "",
  "speech_vs_text": 1.05,
  "boundary_margin": 0.129,
  "confidence": "high"
 },
 {
  "line": 72,
  "start": 230.021,
  "end": 231.274,
  "te": "The blisters cracked.",
  "en": "",
  "speech_vs_text": 0.71,
  "boundary_margin": 0.082,
  "confidence": "high"
 },
 {
  "line": 73,
  "start": 231.634,
  "end": 235.186,
  "te": "And the crack kept growing, until the tube split.",
  "en": "",
  "speech_vs_text": 0.93,
  "boundary_margin": 0.082,
  "confidence": "high"
 },
 {
  "line": 74,
  "start": 235.529,
  "end": 239.375,
  "te": "The operators, I should tell you, brought the reactor safely to a stop.",
  "en": "",
  "speech_vs_text": 0.93,
  "boundary_margin": 0.123,
  "confidence": "high"
 },
 {
  "line": 75,
  "start": 239.803,
  "end": 243.619,
  "te": "But every reactor of this kind now had a question to answer.",
  "en": "",
  "speech_vs_text": 0.98,
  "boundary_margin": 0.123,
  "confidence": "high"
 },
 {
  "line": 76,
  "start": 244.043,
  "end": 247.784,
  "te": "India's tubes at Rawatbhata were made of the same older metal.",
  "en": "",
  "speech_vs_text": 1.06,
  "boundary_margin": 0.319,
  "confidence": "high"
 },
 {
  "line": 77,
  "start": 248.245,
  "end": 255.079,
  "te": "And as Business India reported, Indian engineers were denied detailed knowledge of the accident, its cause and the remedy.",
  "en": "",
  "speech_vs_text": 0.9,
  "boundary_margin": 0.121,
  "confidence": "high"
 },
 {
  "line": 78,
  "start": 255.63,
  "end": 257.727,
  "te": "So India had the same disease.",
  "en": "",
  "speech_vs_text": 1.15,
  "boundary_margin": 0.121,
  "confidence": "high"
 },
 {
  "line": 79,
  "start": 258.165,
  "end": 259.415,
  "te": "And no doctor would come.",
  "en": "",
  "speech_vs_text": 0.95,
  "boundary_margin": 1.889,
  "confidence": "high"
 },
 {
  "line": 80,
  "start": 259.976,
  "end": 260.913,
  "te": "What would you have done?",
  "en": "",
  "speech_vs_text": 0.71,
  "boundary_margin": 0.658,
  "confidence": "high"
 },
 {
  "line": 81,
  "start": 261.94,
  "end": 266.122,
  "te": "In nineteen ninety five, a nuclear trade weekly reported India's decision.",
  "en": "",
  "speech_vs_text": 0.97,
  "boundary_margin": 0.432,
  "confidence": "high"
 },
 {
  "line": 82,
  "start": 266.554,
  "end": 271.291,
  "te": "Rajasthan unit two would get all new tubes, with or without outside help.",
  "en": "",
  "speech_vs_text": 1.03,
  "boundary_margin": 0.187,
  "confidence": "high"
 },
 {
  "line": 83,
  "start": 271.74,
  "end": 276.982,
  "te": "India was still a member of the Kan-doo Owners Group, the club of countries that run this kind of reactor.",
  "en": "",
  "speech_vs_text": 0.88,
  "boundary_margin": 0.187,
  "confidence": "high"
 },
 {
  "line": 84,
  "start": 277.339,
  "end": 282.44,
  "te": "But Canada's export rules kept Canadian firms from supplying the tools, or doing the job.",
  "en": "",
  "speech_vs_text": 1.03,
  "boundary_margin": 0.42,
  "confidence": "high"
 },
 {
  "line": 85,
  "start": 282.966,
  "end": 284.321,
  "te": "So the job came home.",
  "en": "",
  "speech_vs_text": 1.08,
  "boundary_margin": 0.337,
  "confidence": "high"
 },
 {
  "line": 86,
  "start": 284.789,
  "end": 287.762,
  "te": "The project director at Rawatbhata was V K Chaturvedi.",
  "en": "",
  "speech_vs_text": 1.01,
  "boundary_margin": 0.337,
  "confidence": "high"
 },
 {
  "line": 87,
