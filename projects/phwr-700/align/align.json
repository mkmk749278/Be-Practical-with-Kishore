[
 {
  "line": 1,
  "start": 0.0,
  "end": 6.802,
  "te": "In nineteen seventy four, Canada walked out of a half built nuclear reactor on the Chambal river, in Rajasthan.",
  "en": "",
  "speech_vs_text": 1.05,
  "boundary_margin": 0.422,
  "confidence": "high"
 },
 {
  "line": 2,
  "start": 7.322,
  "end": 8.383,
  "te": "India finished it.",
  "en": "",
  "speech_vs_text": 0.91,
  "boundary_margin": 0.422,
  "confidence": "high"
 },
 {
  "line": 3,
  "start": 8.893,
  "end": 11.909,
  "te": "But twenty years later, its heart was wearing out.",
  "en": "",
  "speech_vs_text": 0.98,
  "boundary_margin": 0.388,
  "confidence": "high"
 },
 {
  "line": 4,
  "start": 12.386,
  "end": 14.797,
  "te": "Three hundred and six thin metal tubes.",
  "en": "",
  "speech_vs_text": 1.04,
  "boundary_margin": 0.388,
  "confidence": "high"
 },
 {
  "line": 5,
  "start": 15.325,
  "end": 18.121,
  "te": "Only one country had ever replaced tubes like these.",
  "en": "",
  "speech_vs_text": 0.99,
  "boundary_margin": 0.55,
  "confidence": "high"
 },
 {
  "line": 6,
  "start": 18.596,
  "end": 18.922,
  "te": "Canada.",
  "en": "",
  "speech_vs_text": 0.83,
  "boundary_margin": 1.909,
  "confidence": "high"
 },
 {
  "line": 7,
  "start": 19.506,
  "end": 22.625,
  "te": "And Canada's export rules kept its companies from helping.",
  "en": "",
  "speech_vs_text": 0.91,
  "boundary_margin": 0.723,
  "confidence": "high"
 },
 {
  "line": 8,
  "start": 23.302,
  "end": 27.48,
  "te": "So how do you rebuild the heart of a machine that nobody will teach you to open?",
  "en": "",
  "speech_vs_text": 0.96,
  "boundary_margin": 0.19,
  "confidence": "high"
 },
 {
  "line": 9,
  "start": 28.24,
  "end": 34.233,
  "te": "By the end, you will see Indian engineers pull those tubes out, one by one, into a steel flask.",
  "en": "",
  "speech_vs_text": 1.04,
  "boundary_margin": 0.19,
  "confidence": "high"
 },
 {
  "line": 10,
  "start": 34.677,
  "end": 40.91,
  "te": "And you will see why it matters for the new reactor that began taking in fuel this September, on the same lake.",
  "en": "",
  "speech_vs_text": 0.98,
  "boundary_margin": 0.222,
  "confidence": "high"
 },
 {
  "line": 11,
  "start": 41.476,
  "end": 43.135,
  "te": "Let me take you to Rawatbhata.",
  "en": "",
  "speech_vs_text": 1.05,
  "boundary_margin": 0.301,
  "confidence": "high"
 },
 {
  "line": 12,
  "start": 43.537,
  "end": 48.142,
  "te": "A small town on the Rana Pratap Sagar lake, about sixty four kilometres from Kota.",
  "en": "",
  "speech_vs_text": 1.02,
  "boundary_margin": 0.674,
  "confidence": "high"
 },
 {
  "line": 13,
  "start": 48.835,
  "end": 55.103,
  "te": "If you had come here in the nineteen sixties, you would have seen Canada and India building a nuclear power station together.",
  "en": "",
  "speech_vs_text": 0.89,
  "boundary_margin": 0.48,
  "confidence": "high"
 },
 {
  "line": 14,
  "start": 55.637,
  "end": 57.25,
  "te": "Its design came from Canada.",
  "en": "",
  "speech_vs_text": 0.97,
  "boundary_margin": 0.48,
  "confidence": "high"
 },
 {
  "line": 15,
  "start": 57.673,
  "end": 58.653,
  "te": "And why that design?",
  "en": "",
  "speech_vs_text": 0.93,
  "boundary_margin": 0.571,
  "confidence": "high"
 },
 {
  "line": 16,
  "start": 59.153,
  "end": 61.373,
  "te": "India had picked it for one simple reason.",
  "en": "",
  "speech_vs_text": 0.91,
  "boundary_margin": 0.571,
  "confidence": "high"
 },
 {
  "line": 17,
  "start": 61.801,
  "end": 63.648,
  "te": "It needs no enriched uranium.",
  "en": "",
  "speech_vs_text": 1.17,
  "boundary_margin": 1.105,
  "confidence": "high"
 },
 {
  "line": 18,
  "start": 64.122,
  "end": 68.474,
  "te": "You can run it on natural uranium, with the same mix of atoms you find in nature.",
  "en": "",
  "speech_vs_text": 0.99,
  "boundary_margin": 1.023,
  "confidence": "high"
 },
 {
  "line": 19,
  "start": 69.012,
  "end": 70.986,
  "te": "And Indian factories could build it.",
  "en": "",
  "speech_vs_text": 0.87,
  "boundary_margin": 0.314,
  "confidence": "high"
 },
 {
  "line": 20,
  "start": 71.523,
  "end": 75.77,
  "te": "Now, you have probably seen a reactor drawn as one giant steel pot.",
  "en": "",
  "speech_vs_text": 1.22,
  "boundary_margin": 0.314,
  "confidence": "high"
 },
 {
  "line": 21,
  "start": 76.215,
  "end": 78.223,
  "te": "Most reactors in the world are just that.",
  "en": "",
  "speech_vs_text": 0.92,
  "boundary_margin": 0.546,
  "confidence": "high"
 },
 {
  "line": 22,
  "start": 78.684,
  "end": 79.928,
  "te": "This one is different.",
  "en": "",
  "speech_vs_text": 0.82,
  "boundary_margin": 0.49,
  "confidence": "high"
 },
 {
  "line": 23,
  "start": 80.655,
  "end": 83.99,
  "te": "Imagine a tank, pierced by three hundred and six tubes.",
  "en": "",
  "speech_vs_text": 1.05,
  "boundary_margin": 0.49,
  "confidence": "high"
 },
 {
  "line": 24,
  "start": 84.402,
  "end": 87.555,
  "te": "Each tube, if you like, is its own small pressure cooker.",
  "en": "",
  "speech_vs_text": 0.98,
  "boundary_margin": 0.502,
  "confidence": "high"
 },
 {
  "line": 25,
  "start": 88.095,
  "end": 89.439,
  "te": "Think of the cooker in your kitchen.",
  "en": "",
  "speech_vs_text": 0.7,
  "boundary_margin": 0.617,
  "confidence": "high"
 },
 {
  "line": 26,
  "start": 89.799,
  "end": 91.972,
  "te": "You know that whistle, you have heard it all your life.",
  "en": "",
  "speech_vs_text": 0.69,
  "boundary_margin": 0.272,
  "confidence": "check"
 },
 {
  "line": 27,
  "start": 92.59,
  "end": 96.856,
  "te": "Inside, the steam pushes at about one kilo on every square centimetre.",
  "en": "",
  "speech_vs_text": 1.09,
  "boundary_margin": 0.272,
  "confidence": "high"
 },
 {
  "line": 28,
  "start": 97.409,
  "end": 100.348,
  "te": "Now jump ahead to India's newest reactors for a moment.",
  "en": "",
  "speech_vs_text": 0.93,
  "boundary_margin": 0.063,
  "confidence": "high"
 },
 {
  "line": 29,
  "start": 100.799,
  "end": 107.097,
  "te": "There, the water in each tube is pushed a hundred times harder, at three hundred and ten degrees.",
  "en": "",
  "speech_vs_text": 1.08,
  "boundary_margin": 0.063,
  "confidence": "high"
 },
 {
  "line": 30,
  "start": 107.558,
  "end": 112.78,
  "te": "And in reactors of this family, the wall of that tube is only about four millimetres thick.",
  "en": "",
  "speech_vs_text": 0.98,
  "boundary_margin": 0.282,
  "confidence": "high"
 },
 {
  "line": 31,
  "start": 113.229,
  "end": 113.99,
  "te": "Think of a pencil.",
  "en": "",
  "speech_vs_text": 0.83,
  "boundary_margin": 0.36,
  "confidence": "high"
 },
 {
  "line": 32,
  "start": 114.413,
  "end": 115.906,
  "te": "The wall is thinner than that.",
  "en": "",
  "speech_vs_text": 0.85,
  "boundary_margin": 0.36,
  "confidence": "high"
 },
 {
  "line": 33,
  "start": 116.482,
  "end": 118.523,
  "te": "Then came May nineteen seventy four.",
  "en": "",
  "speech_vs_text": 1.03,
  "boundary_margin": 1.29,
  "confidence": "high"
 },
 {
  "line": 34,
  "start": 118.953,
  "end": 119.618,
  "te": "You remember it.",
  "en": "",
  "speech_vs_text": 0.78,
  "boundary_margin": 9.9,
  "confidence": "high"
 },
 {
  "line": 35,
  "start": 120.002,
  "end": 120.401,
  "te": "Pokhran.",
  "en": "",
  "speech_vs_text": 0.87,
  "boundary_margin": 9.9,
  "confidence": "high"
 },
 {
  "line": 36,
  "start": 121.049,
  "end": 122.541,
  "te": "Why did Canada care so much?",
  "en": "",
  "speech_vs_text": 1.03,
  "boundary_margin": 1.6,
  "confidence": "high"
 },
 {
  "line": 37,
  "start": 123.075,
  "end": 124.835,
  "te": "India called its test peaceful.",
  "en": "",
  "speech_vs_text": 0.92,
  "boundary_margin": 0.293,
  "confidence": "high"
 },
 {
  "line": 38,
  "start": 125.36,
  "end": 131.524,
  "te": "Canada saw plutonium from a research reactor near Mumbai, called Sigh-rus, which Canada had helped design.",
  "en": "",
  "speech_vs_text": 0.97,
  "boundary_margin": 0.293,
  "confidence": "high"
 },
 {
  "line": 39,
  "start": 132.026,
  "end": 133.87,
  "te": "So Canada stopped its nuclear help.",
  "en": "",
  "speech_vs_text": 0.97,
  "boundary_margin": 0.614,
  "confidence": "high"
 },
 {
  "line": 40,
  "start": 134.365,
  "end": 136.228,
  "te": "The engineers packed up and went home.",
  "en": "",
  "speech_vs_text": 0.79,
  "boundary_margin": 0.468,
  "confidence": "high"
 },
 {
  "line": 41,
  "start": 136.706,
  "end": 138.135,
  "te": "The first unit was running.",
  "en": "",
  "speech_vs_text": 0.86,
  "boundary_margin": 0.241,
  "confidence": "high"
 },
 {
  "line": 42,
  "start": 138.643,
  "end": 144.285,
  "te": "The second, as an Indian magazine put it in nineteen ninety six, the Canadians abandoned halfway.",
  "en": "",
  "speech_vs_text": 0.93,
  "boundary_margin": 0.241,
  "confidence": "high"
 },
 {
  "line": 43,
  "start": 144.925,
  "end": 148.784,
  "te": "Now you might ask me, Kishore, so what happened to your half built reactor?",
  "en": "",
  "speech_vs_text": 0.87,
  "boundary_margin": 0.337,
  "confidence": "high"
 },
 {
  "line": 44,
  "start": 149.499,
  "end": 151.733,
  "te": "Indian engineers finished it on their own.",
  "en": "",
  "speech_vs_text": 0.97,
  "boundary_margin": 1.649,
  "confidence": "high"
 },
 {
  "line": 45,
  "start": 152.083,
  "end": 153.917,
  "te": "It went to work in nineteen eighty one.",
  "en": "",
  "speech_vs_text": 0.9,
  "boundary_margin": 0.616,
  "confidence": "high"
 },
 {
  "line": 46,
  "start": 154.35,
  "end": 155.935,
  "te": "And for a while, all was well.",
  "en": "",
  "speech_vs_text": 0.93,
  "boundary_margin": 0.373,
  "confidence": "high"
 },
 {
  "line": 47,
  "start": 156.296,
  "end": 163.752,
  "te": "At Kaiga in Karnataka, a reactor of this family once ran for nine hundred and sixty two days without stopping.",
  "en": "",
  "speech_vs_text": 1.15,
  "boundary_margin": 0.373,
  "confidence": "high"
 },
 {
  "line": 48,
  "start": 164.211,
  "end": 165.044,
  "te": "A world record.",
  "en": "",
  "speech_vs_text": 1.05,
  "boundary_margin": 0.226,
  "confidence": "high"
 },
 {
  "line": 49,
  "start": 165.439,
  "end": 167.566,
  "te": "So what stops a machine like that?",
  "en": "",
  "speech_vs_text": 1.1,
  "boundary_margin": 0.226,
  "confidence": "high"
 },
 {
  "line": 50,
  "start": 167.934,
  "end": 169.346,
  "te": "You might guess the fuel.",
  "en": "",
  "speech_vs_text": 0.92,
  "boundary_margin": 0.533,
  "confidence": "high"
 },
 {
  "line": 51,
  "start": 169.801,
  "end": 170.88,
  "te": "It is not the fuel.",
  "en": "",
  "speech_vs_text": 1.17,
  "boundary_margin": 0.533,
  "confidence": "high"
 },
 {
  "line": 52,
  "start": 171.182,
  "end": 173.512,
  "te": "You can feed fresh fuel in while it runs.",
  "en": "",
  "speech_vs_text": 1.11,
  "boundary_margin": 0.479,
  "confidence": "high"
 },
 {
  "line": 53,
  "start": 173.889,
  "end": 175.759,
  "te": "What wears out is the tubes.",
  "en": "",
  "speech_vs_text": 1.16,
  "boundary_margin": 0.291,
  "confidence": "high"
 },
 {
  "line": 54,
  "start": 176.083,
  "end": 178.71,
  "te": "The early tubes were made of an older metal mix.",
  "en": "",
  "speech_vs_text": 1.05,
  "boundary_margin": 0.291,
  "confidence": "high"
 },
 {
  "line": 55,
  "start": 179.081,
  "end": 181.248,
  "te": "Over the years they soaked up hydrogen.",
  "en": "",
  "speech_vs_text": 0.94,
  "boundary_margin": 0.226,
  "confidence": "high"
 },
 {
  "line": 56,
  "start": 181.627,
  "end": 188.207,
  "te": "N-P-C-I-L, the company that runs India's nuclear plants, says they lasted only ten to twelve years.",
  "en": "",
  "speech_vs_text": 1.18,
  "boundary_margin": 0.031,
  "confidence": "check"
 },
 {
  "line": 57,
  "start": 188.516,
  "end": 193.131,
  "te": "In August nineteen eighty three, near Toronto, the world saw what that means.",
  "en": "",
  "speech_vs_text": 1.05,
  "boundary_margin": 0.031,
  "confidence": "check"
 },
 {
  "line": 58,
  "start": 193.465,
  "end": 196.787,
  "te": "At the Pickering station, one tube broke at full power.",
  "en": "",
  "speech_vs_text": 1.08,
  "boundary_margin": 0.26,
  "confidence": "high"
 },
 {
  "line": 59,
  "start": 197.198,
  "end": 199.111,
  "te": "Just one, out of hundreds.",
  "en": "",
  "speech_vs_text": 1.19,
  "boundary_margin": 0.008,
  "confidence": "check"
 },
 {
  "line": 60,
  "start": 199.402,
  "end": 200.988,
  "te": "But that is all it takes.",
  "en": "",
  "speech_vs_text": 1.02,
  "boundary_margin": 0.008,
  "confidence": "check"
 },
 {
  "line": 61,
  "start": 201.316,
  "end": 203.008,
  "te": "How does a tube just break?",
  "en": "",
  "speech_vs_text": 1.22,
  "boundary_margin": 0.252,
  "confidence": "high"
 },
 {
  "line": 62,
  "start": 203.376,
  "end": 205.975,
  "te": "Each hot tube sits inside a cooler tube.",
  "en": "",
  "speech_vs_text": 1.16,
  "boundary_margin": 0.252,
  "confidence": "high"
 },
 {
  "line": 63,
  "start": 206.234,
  "end": 209.789,
  "te": "Small coiled springs, wrapped around it, keep the two apart.",
  "en": "",
  "speech_vs_text": 1.08,
  "boundary_margin": 0.317,
  "confidence": "high"
 },
 {
  "line": 64,
  "start": 210.077,
  "end": 213.211,
  "te": "In that one channel, a spring had slipped out of place.",
  "en": "",
  "speech_vs_text": 1.04,
  "boundary_margin": 0.127,
  "confidence": "high"
 },
 {
  "line": 65,
  "start": 213.463,
  "end": 215.502,
  "te": "Slowly, the hot tube sagged.",
  "en": "",
  "speech_vs_text": 1.17,
  "boundary_margin": 0.127,
  "confidence": "high"
 },
 {
  "line": 66,
  "start": 215.752,
  "end": 217.532,
  "te": "Then it touched the cold one.",
  "en": "",
  "speech_vs_text": 0.9,
  "boundary_margin": 0.186,
  "confidence": "high"
 },
 {
  "line": 67,
  "start": 217.874,
  "end": 220.41,
  "te": "Now think of a glass of cold water on a hot day.",
  "en": "",
  "speech_vs_text": 1.07,
  "boundary_margin": 1.071,
  "confidence": "high"
 },
 {
  "line": 68,
  "start": 220.731,
  "end": 223.971,
  "te": "You have seen the drops gather on the outside, on the cold glass.",
  "en": "",
  "speech_vs_text": 0.91,
  "boundary_margin": 0.254,
  "confidence": "high"
 },
 {
  "line": 69,
  "start": 224.278,
  "end": 228.15,
  "te": "Inside the metal, hydrogen did something like the drops you just pictured.",
  "en": "",
  "speech_vs_text": 0.88,
  "boundary_margin": 0.254,
  "confidence": "high"
 },
 {
  "line": 70,
  "start": 228.484,
  "end": 230.26,
  "te": "It crept to the coldest spot.",
  "en": "",
  "speech_vs_text": 1.06,
  "boundary_margin": 0.1,
  "confidence": "high"
 },
 {
  "line": 71,
  "start": 230.65,
  "end": 233.594,
  "te": "And there it hardened into brittle blisters.",
  "en": "",
  "speech_vs_text": 1.06,
  "boundary_margin": 0.1,
  "confidence": "high"
 },
 {
  "line": 72,
  "start": 233.861,
  "end": 235.887,
  "te": "The blisters cracked.",
  "en": "",
  "speech_vs_text": 1.19,
  "boundary_margin": 0.005,
  "confidence": "check"
 },
 {
  "line": 73,
  "start": 236.151,
  "end": 238.744,
  "te": "And the crack kept growing, until the tube split.",
  "en": "",
  "speech_vs_text": 0.81,
  "boundary_margin": 0.005,
  "confidence": "check"
 },
 {
  "line": 74,
  "start": 239.039,
  "end": 242.695,
  "te": "The operators, I should tell you, brought the reactor safely to a stop.",
  "en": "",
  "speech_vs_text": 0.91,
  "boundary_margin": 0.014,
  "confidence": "check"
 },
 {
  "line": 75,
  "start": 243.086,
  "end": 246.6,
  "te": "But every reactor of this kind now had a question to answer.",
  "en": "",
  "speech_vs_text": 1.06,
  "boundary_margin": 0.014,
  "confidence": "check"
 },
 {
  "line": 76,
  "start": 246.912,
  "end": 250.412,
  "te": "India's tubes at Rawatbhata were made of the same older metal.",
  "en": "",
  "speech_vs_text": 1.06,
  "boundary_margin": 0.244,
  "confidence": "high"
 },
 {
  "line": 77,
  "start": 250.713,
  "end": 257.431,
  "te": "And as Business India reported, Indian engineers were denied detailed knowledge of the accident, its cause and the remedy.",
  "en": "",
  "speech_vs_text": 0.88,
  "boundary_margin": 0.225,
  "confidence": "high"
 },
 {
  "line": 78,
  "start": 257.742,
  "end": 259.626,
  "te": "So India had the same disease.",
  "en": "",
  "speech_vs_text": 1.19,
  "boundary_margin": 0.225,
  "confidence": "high"
 },
 {
  "line": 79,
  "start": 259.977,
  "end": 261.098,
  "te": "And no doctor would come.",
  "en": "",
  "speech_vs_text": 0.85,
  "boundary_margin": 9.9,
  "confidence": "high"
 },
 {
  "line": 80,
  "start": 261.562,
  "end": 262.552,
  "te": "What would you have done?",
  "en": "",
  "speech_vs_text": 0.75,
  "boundary_margin": 0.691,
  "confidence": "high"
 },
 {
  "line": 81,
  "start": 263.56,
  "end": 267.742,
  "te": "In nineteen ninety five, a nuclear trade weekly reported India's decision.",
  "en": "",
  "speech_vs_text": 0.97,
  "boundary_margin": 0.465,
  "confidence": "high"
 },
 {
  "line": 82,
  "start": 268.174,
  "end": 272.911,
  "te": "Rajasthan unit two would get all new tubes, with or without outside help.",
  "en": "",
  "speech_vs_text": 1.0,
  "boundary_margin": 0.148,
  "confidence": "high"
 },
 {
  "line": 83,
  "start": 273.36,
  "end": 278.602,
  "te": "India was still a member of the Kan-doo Owners Group, the club of countries that run this kind of reactor.",
  "en": "",
  "speech_vs_text": 0.88,
  "boundary_margin": 0.148,
  "confidence": "high"
 },
 {
  "line": 84,
  "start": 278.959,
  "end": 284.06,
  "te": "But Canada's export rules kept Canadian firms from supplying the tools, or doing the job.",
  "en": "",
  "speech_vs_text": 1.03,
  "boundary_margin": 0.421,
  "confidence": "high"
 },
 {
  "line": 85,
  "start": 284.586,
  "end": 285.941,
  "te": "So the job came home.",
  "en": "",
  "speech_vs_text": 1.08,
  "boundary_margin": 0.338,
  "confidence": "high"
 },
 {
  "line": 86,
  "start": 286.41,
  "end": 289.382,
  "te": "The project director at Rawatbhata was V K Chaturvedi.",
  "en": "",
  "speech_vs_text": 1.0,
  "boundary_margin": 0.338,
  "confidence": "high"
 },
 {
  "line": 87,
