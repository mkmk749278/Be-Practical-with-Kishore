  "speech_vs_text": 1.33,
  "boundary_margin": 0.197,
  "confidence": "high"
 },
 {
  "line": 136,
  "start": 434.894,
  "end": 435.709,
  "te": "What went wrong?",
  "en": "",
  "speech_vs_text": 0.95,
  "boundary_margin": 0.822,
  "confidence": "high"
 },
 {
  "line": 137,
  "start": 436.067,
  "end": 438.993,
  "te": "A wrong chemical had got into the gas around the tubes.",
  "en": "",
  "speech_vs_text": 1.01,
  "boundary_margin": 9.9,
  "confidence": "high"
 },
 {
  "line": 138,
  "start": 439.285,
  "end": 441.967,
  "te": "It had eaten small spots into their outer walls.",
  "en": "",
  "speech_vs_text": 1.04,
  "boundary_margin": 0.207,
  "confidence": "high"
 },
 {
  "line": 139,
  "start": 442.313,
  "end": 443.665,
  "te": "And was it everywhere?",
  "en": "",
  "speech_vs_text": 1.01,
  "boundary_margin": 0.207,
  "confidence": "high"
 },
 {
  "line": 140,
  "start": 444.065,
