  "en": "",
  "speech_vs_text": 0.96,
  "boundary_margin": 0.416,
  "confidence": "high"
 },
 {
  "line": 115,
  "start": 376.577,
  "end": 380.365,
  "te": "About one thousand one hundred crore rupees of extra electricity.",
  "en": "",
  "speech_vs_text": 1.0,
  "boundary_margin": 0.244,
  "confidence": "high"
 },
 {
  "line": 116,
  "start": 380.695,
  "end": 383.262,
  "te": "You remember how we never threw away a broken radio?",
