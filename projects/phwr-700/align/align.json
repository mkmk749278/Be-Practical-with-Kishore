  "te": "Critical?",
  "en": "",
  "speech_vs_text": 0.85,
  "boundary_margin": 2.119,
  "confidence": "high"
 },
 {
  "line": 157,
  "start": 496.389,
  "end": 497.462,
  "te": "That is good news here.",
