  "te": "You cannot stand near it.",
  "en": "",
  "speech_vs_text": 1.0,
  "boundary_margin": 9.9,
  "confidence": "high"
 },
 {
  "line": 91,
  "start": 302.588,
  "end": 303.546,
  "te": "Not for a minute.",
  "en": "",
  "speech_vs_text": 1.12,
  "boundary_margin": 0.336,
  "confidence": "high"
 },
 {
  "line": 92,
  "start": 303.921,
  "end": 308.659,
