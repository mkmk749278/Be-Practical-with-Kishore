  "speech_vs_text": 0.97,
  "boundary_margin": 9.9,
  "confidence": "high"
 },
 {
  "line": 125,
  "start": 404.24,
  "end": 405.624,
  "te": "Is it safe to live near one?",
  "en": "",
  "speech_vs_text": 1.0,
  "boundary_margin": 9.9,
  "confidence": "high"
 },
 {
